# Include Laravel's own error log (storage/logs) in the Elastic Beanstalk
# console's "Request logs" downloads, next to the nginx and deploy logs.
files:
  "/opt/elasticbeanstalk/tasks/taillogs.d/laravel.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/app/current/storage/logs/*.log
  "/opt/elasticbeanstalk/tasks/bundlelogs.d/laravel.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/app/current/storage/logs/*.log
