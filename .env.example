APP_NAME="Local Goods"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The address people use. In production this is the CloudFront https address
# (no trailing slash): every link, redirect and invite link is built from it.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses SQLite (storage/database.sqlite).
# Production sets these as Elastic Beanstalk environment properties instead,
# pointing at Amazon RDS MySQL. Never put real credentials in this file.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=
# DB_PORT=3306
# DB_DATABASE=local_goods
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true = the login cookie is only sent over HTTPS. Leave blank locally (the dev
# server is plain http). Production sets true in .ebextensions/laravel.config.
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Production only: the same random secret CloudFront sends to Beanstalk in its
# X-Origin-Verify origin header. Only requests carrying it have their
# X-Forwarded-For (the visitor's real IP) believed. Leave blank locally.
CLOUDFRONT_ORIGIN_SECRET=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Demo logins, one per role, created by `php artisan demo:seed-accounts`
# (the Beanstalk deploy hook runs it too). Set a password for each account
# you want; a blank one means that account is skipped. Never commit values.
DEMO_PASSWORD_PLATFORM_ADMIN=
DEMO_PASSWORD_BID_ADMIN=
DEMO_PASSWORD_EMPLOYER_ADMIN=
DEMO_PASSWORD_EMPLOYEE=
DEMO_PASSWORD_MERCHANT=
DEMO_PASSWORD_JUDGE=
# Optional: your own name and email for the platform admin account.
PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_EMAIL=

VITE_APP_NAME="${APP_NAME}"
